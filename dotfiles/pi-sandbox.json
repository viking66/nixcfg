{
  "enabled": true,
  "sandboxUserShell": true,
  "permissionPromptTimeoutSeconds": 60,
  "filesystem": {
    "allowRead": [".", "~/.config", "~/.local", "~/Library"],
    "allowWrite": [".", "/tmp", "/private/tmp"],
    "denyWrite": [".env", ".env.*", "*.pem", "*.key", "~/.ssh", "~/.pi/agent/sandbox.json", "~/.pi/agent/pi-permissions.jsonc", ".pi/sandbox.json", ".pi/agent/pi-permissions.jsonc"]
  },
  "network": {
    "allowedDomains": ["github.com", "*.github.com", "raw.githubusercontent.com", "registry.npmjs.org", "npmjs.org", "*.npmjs.org", "pypi.org", "*.pypi.org"],
    "deniedDomains": []
  }
}
